{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/features/components/ui/*.tsx",
    "electron.vite.config.ts",
    "electron/main/index.ts",
    "electron/preload/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "electron/**/*.ts", "*.ts"],
  "ignore": ["electron/main/assets.d.ts", "src/testing/fake-tauri.ts"],
  "ignoreDependencies": ["@tauri-apps/*", "@napi-rs/cli"],
  "ignoreExportsUsedInFile": true
}
