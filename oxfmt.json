{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "singleQuote": true,
  "trailingComma": "none",

  "sortImports": true,

  "sortPackageJson": {
    "sortScripts": true
  },

  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "./src/styles/main.css"
  },

  "ignorePatterns": [
    "dist",
    "node_modules",
    "tauri-bindings",
    "src/bindings/types.ts",
    "crates/tinydiff-napi/index.d.ts",
    "**/*.toml",
    "**/*.md"
  ]
}
