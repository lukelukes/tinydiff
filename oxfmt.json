{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "singleQuote": true,
  "trailingComma": "none",

  "sortImports": true,

  "sortPackageJson": {
    "sortScripts": true
  },

  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "./src/styles/main.css"
  },

  "ignorePatterns": ["dist", "node_modules", "tauri-bindings", "**/*.toml", "**/*.md"]
}
