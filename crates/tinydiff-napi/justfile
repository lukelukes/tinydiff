set quiet
set shell := ["bash", "-euo", "pipefail", "-c"]

pkg := "tinydiff-napi"
dts_header := "import type { AppMode, Comment, CommandError, CommentCollection, DiffTarget, FileDiff, GitFileContents, GitStatus, ReadFileResult, Result } from '../../src/bindings/types';"

[group('check')]
fmt:
    cargo fmt -p {{ pkg }}

[group('check')]
fmt-check:
    cargo fmt -p {{ pkg }} -- --check

[group('check')]
clippy:
    cargo clippy -p {{ pkg }} -- -D warnings

[group('check')]
[parallel]
check: fmt-check clippy types-check

[group('build')]
[no-cd]
build:
    bunx napi build --release --manifest-path crates/tinydiff-napi/Cargo.toml --output-dir crates/tinydiff-napi --dts-header "{{ dts_header }}"

[group('build')]
[no-cd]
types:
    cargo run -p tinydiff-core --example export-types --features specta

[group('check')]
[no-cd]
types-check:
    cargo run -p tinydiff-core --example export-types --features specta -- --check
