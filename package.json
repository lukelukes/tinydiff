{
  "name": "tinydiff",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "imports": {
    "#features/*": "./src/features/*",
    "#core/*": "./src/core/*",
    "#testing/*": "./src/testing/*",
    "#bindings/*": "./src/bindings/*.ts"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "electron:build": "just napi::build && electron-vite build",
    "fmt": "oxfmt --config oxfmt.json --write",
    "fmt:check": "oxfmt --config oxfmt.json --check",
    "knip": "knip",
    "lint": "bun run lint:electron && bun run lint:e2e && bun run lint:node && bun run lint:renderer",
    "lint:e2e": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.e2e.json e2e",
    "lint:electron": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.electron.json electron",
    "lint:fix": "bun run lint:electron --fix && bun run lint:e2e --fix && bun run lint:node --fix && bun run lint:renderer --fix",
    "lint:node": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.node.json vite.config.ts vite.renderer.ts vitest.config.ts electron.vite.config.ts",
    "lint:renderer": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.json src public dev",
    "postinstall": "install-electron",
    "test": "vitest --run --project unit --project property --project browser",
    "test:browser": "bun vitest run --project browser",
    "test:browser:headed": "HEADED=true bun vitest run --project browser",
    "test:e2e": "bun vitest run --project e2e",
    "test:property": "bun vitest run --project property",
    "test:unit": "bun vitest run --project unit",
    "test:watch": "bun vitest",
    "typecheck": "tsc && bun run typecheck:electron",
    "typecheck:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.node.json",
    "upgrade-deps": "bunx npm-check-updates -i",
    "validate": "bun run fmt && bun run lint:fix && bun run electron:build --logLevel warn && concurrently -g 'bun:build --logLevel warn' 'bun:typecheck:electron' 'bun:test'"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@base-ui/react": "1.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hugeicons/core-free-icons": "4.0.0",
    "@hugeicons/react": "1.1.6",
    "@napi-rs/cli": "3.9.1",
    "@pierre/diffs": "1.4.2",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.2.2",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "9.2.1",
    "electron": "44.3.0",
    "electron-vite": "6.0.0-beta.1",
    "fast-check": "4.6.0",
    "knip": "6.0.6",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.0.3",
    "vitest": "4.1.2",
    "vitest-browser-react": "2.1.0"
  },
  "napi": {
    "binaryName": "tinydiff"
  }
}
