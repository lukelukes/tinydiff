{
  "name": "tinydiff",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "imports": {
    "#features/*": "./src/features/*",
    "#core/*": "./src/core/*",
    "#lib/*": "./src/lib/*",
    "#testing/*": "./src/testing/*",
    "#tauri-bindings/*": "./tauri-bindings/*.ts"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "electron:build": "electron-vite build",
    "electron:dev": "electron-vite dev -w --sourcemap",
    "electron:preview": "electron-vite preview",
    "fmt": "oxfmt --config oxfmt.json --write",
    "fmt:check": "oxfmt --config oxfmt.json --check",
    "knip": "knip",
    "lint": "bun run lint:electron && bun run lint:node && bun run lint:renderer",
    "lint:electron": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.electron.json electron e2e",
    "lint:fix": "bun run lint:electron --fix && bun run lint:node --fix && bun run lint:renderer --fix",
    "lint:node": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.node.json vite.config.ts vite.renderer.ts vitest.config.ts electron.vite.config.ts",
    "lint:renderer": "oxlint --type-aware --type-check --config oxlint.json -f stylish --tsconfig tsconfig.json src public",
    "postinstall": "install-electron",
    "tauri": "tauri",
    "test": "vitest --run",
    "test:browser": "bun vitest run --project browser",
    "test:browser:headed": "HEADED=true bun vitest run --project browser",
    "test:property": "bun vitest run --project property",
    "test:unit": "bun vitest run --project unit",
    "test:watch": "bun vitest",
    "typecheck": "tsc && tsc -p tsconfig.electron.json && tsc -p tsconfig.node.json",
    "typecheck:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.node.json",
    "upgrade-deps": "bunx npm-check-updates -i",
    "validate": "bun run fmt && bun run lint:fix && concurrently -g 'bun:build --logLevel warn' 'bun:typecheck:electron' 'bun:test'"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@hugeicons/core-free-icons": "4.0.0",
    "@hugeicons/react": "1.1.6",
    "@pierre/diffs": "1.4.2",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tauri-apps/plugin-store": "2.4.2",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@napi-rs/cli": "3.9.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.2.2",
    "@tauri-apps/cli": "2.10.1",
    "@types/bun": "1.3.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "9.2.1",
    "electron": "44.3.0",
    "electron-vite": "6.0.0-beta.1",
    "fast-check": "4.6.0",
    "knip": "6.0.6",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.63.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.0.3",
    "vitest": "4.1.2",
    "vitest-browser-react": "2.1.0"
  },
  "napi": {
    "binaryName": "tinydiff"
  },
  "trustedDependencies": [
    "electron"
  ]
}
